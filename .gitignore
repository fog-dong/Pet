# Cocos Creator generated / local (root only)
/library/
/temp/
/build/
/local/
/profiles/
/native/
/packages/
/.editor/
/.meta-cache/
/.preview/
/node_modules/

# 云函数本地依赖：由各函数 package.json 声明，云端安装，不入库
/cloudfunctions/*/node_modules/

# 编辑器扩展（本地开发工具，非工程源码）
/extensions/

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Env and secrets
.env
.env.*
*.pem
*.key

# 微信开发者工具本地配置：含真实 AppID 与本地设置，禁止入库（正式 AppID 只经构建参数注入）
/project.config.json
/project.private.config.json

# IDE
.vscode/
.idea/
