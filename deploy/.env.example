# 部署仅需：镜像、端口、数据库、微信与 JWT（详见 deploy/README.md）

API_IMAGE=registry.cn-hangzhou.aliyuncs.com/jiangker/pet-api:latest
HOST_PORT=18766

DATABASE_URL=postgres://pet:PASSWORD@host.docker.internal:5432/pet
RUST_LOG=info,sqlx=warn,tower_http=info

WX_APPID=你的小游戏AppId
WX_SECRET=你的小游戏AppSecret
JWT_SECRET=随机长字符串

# 可选
# PENDING_MONITOR_SECS=3600
