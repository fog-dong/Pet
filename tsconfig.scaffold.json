{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "cc": ["temp/declarations/cc.d.ts"]
    },
    "experimentalDecorators": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2019", "DOM"],
    "types": []
  },
  "include": ["assets/scripts/**/*.ts", "temp/declarations/cc.env.d.ts"]
}
